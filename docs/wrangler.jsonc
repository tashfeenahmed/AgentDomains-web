{
  "name": "agentdns-docs",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "workers_dev": false,
  // run_worker_first so worker.js gets to answer a request for "/" on
  // docs.makes.fyi with a 301; without it index.html would be served first and
  // the redirect would never run. docs.agentdomains.co falls through to the
  // assets through env.ASSETS, unchanged.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Custom domains, one hostname each — never a wildcard on the makes.fyi zone.
  "routes": [
    { "pattern": "docs.agentdomains.co", "custom_domain": true },
    { "pattern": "docs.makes.fyi", "custom_domain": true }
  ]
}
